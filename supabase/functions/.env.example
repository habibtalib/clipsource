# Edge Function secrets. Hosted: `supabase secrets set --env-file supabase/functions/.env`.
# Local: `supabase functions serve --env-file supabase/functions/.env`. Never commit the filled-in file.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase; do not set them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_YEAR=
SITE_URL=
# Optional. 1 = also allow http://localhost / 127.0.0.1 origins (local development only; off in production).
ALLOW_LOCALHOST=
# Optional. Base URL of a local Stripe stand-in for tests; leave empty for https://api.stripe.com.
STRIPE_API_BASE=
